{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:@libsql/client --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "ingest": "tsx src/cli/ingest.ts",
    "history": "tsx src/cli/history.ts",
    "backfill": "tsx src/cli/backfill.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "nanoid": "^5.1.0",
    "shared": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
