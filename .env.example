# --- Database (Turso). Leave unset for local dev -> file:local.db ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- App ---
# Shared household password (HTTP Basic; the username is ignored).
# Unset locally = auth disabled in dev. Required in production.
APP_PASSWORD=

# No ANTHROPIC_API_KEY here on purpose: plan generation runs locally in
# Claude Code (/meal-prep) and writes to Turso via `pnpm ingest` — the
# server never calls a model.
